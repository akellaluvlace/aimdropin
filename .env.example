# Asset library - API keys
#
# Each variable below powers an asset panel that fetches from a third-party
# API. Without the key, the panel renders a "not configured" empty state with
# a setup link - nothing blocks app boot. Copy this file to `.env.local` and
# fill the keys you want to enable, then restart the dev server.
#
# Pre-bundled panels (Lucide, Emoji, Palettes, Google Fonts curated list)
# work offline and need no env vars.

# Unsplash - search photos. Free dev tier: 50 req/hour.
# Sign up: https://unsplash.com/developers (create an app, copy "Access Key")
UNSPLASH_ACCESS_KEY=

# Pexels - search photos and videos. Free, 200 req/hour. (Tier 2)
# Sign up: https://www.pexels.com/api/
PEXELS_API_KEY=

# Pixabay - search photos / illustrations / vectors. Free, 100 req/60s,
# instant key (email signup, no review). CC0-equivalent license.
# Sign up: https://pixabay.com/api/docs/
PIXABAY_API_KEY=

# Public site URL (canonical links, sitemap). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.aimdropin.com

# Supabase - accounts, stars, ratings, usage counts, saved and published
# pages. Optional: without these the site works as before, signed out, with
# no counts. Setup steps: supabase/README.md.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server / CLI only (npm run review). Bypasses row-level security: never
# expose it to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Connect-your-AI needs no server keys: users connect OpenRouter (OAuth) or
# paste their own Anthropic / OpenAI / OpenRouter key, and calls go straight
# from their browser to the provider.

# --- Live dashboard demos -------------------------------------------------
# Production serves the demos' files from a public storage bucket instead of
# the deployment. Upload them with
#   node --env-file=.env.local scripts/dashboards/upload-demos.mjs
# (reads PROD_SUPABASE_URL + PROD_SUPABASE_SERVICE_ROLE_KEY), then set:
# DEMO_STORAGE_URL=https://<project-ref>.supabase.co/storage/v1/object/public/demos
# Leave unset locally: demos are read from demos/ and public/demos/ on disk.
DEMO_STORAGE_URL=
# Upload-script credentials (local only, never on the host):
# PROD_SUPABASE_URL=https://<project-ref>.supabase.co
# PROD_SUPABASE_SERVICE_ROLE_KEY=

# --- Accounts, ratings, studio, community ---------------------------------
# Built but switched off until launch. "1" turns them on (needs the
# NEXT_PUBLIC_SUPABASE_* keys and the migrations in supabase/migrations).
NEXT_PUBLIC_FEATURE_ACCOUNTS=

# --- GSAP sites: remaking their pictures (optional) -----------------------
# Only scripts/gsap/<site>/gen.mjs reads this, to generate new photographs on
# fal.ai. It spends credit on your account. The sites run without it.
# fal_api=
