    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.19",
    "fake-indexeddb": "^6.2.5",
    "gray-matter": "^4.0.3",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.39",
    "postcss-prefix-selector": "^2.1.1",
    "prettier": "^3.3.3",
    "puppeteer": "^24.42.0",
    "sharp": "^0.34.5",
