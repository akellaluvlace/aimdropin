    "thumbs": "node scripts/gen-thumbs.mjs",
    "build:assets": "node scripts/build-assets/build-all.mjs",
    "catalog": "node scripts/catalog/build-catalog.mjs",
    "catalog:publish": "node scripts/catalog/publish-catalog.mjs",
    "review": "node scripts/community/review.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@babel/parser": "^7.29.2",
    "@babel/types": "^7.29.0",
    "@heroicons/react": "^2.2.0",
    "@monaco-editor/react": "^4.6.0",
    "@phosphor-icons/core": "^2.1.1",
    "@supabase/supabase-js": "^2.118.0",
    "@tabler/icons": "^3.41.1",
    "gsap": "^3.15.0",
    "heroicons": "^2.2.0",
    "idb": "^8.0.3",
    "lucide-static": "^1.11.0",
    "magic-string": "^0.30.21",
    "minisearch": "^7.2.0",
    "next": "^16.4.6",
    "parse5": "^8.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "simple-icons": "^16.18.0",
    "unicode-emoji-json": "^0.9.0"
  },
  "devDependencies": {
